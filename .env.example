# بيانات محلية فقط؛ لا تستخدمها في الإنتاج.
DATABASE_URL=postgresql://petra:petra_local_only@127.0.0.1:5432/petra_dev
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
API_HOST=127.0.0.1
PETRA_DEMO_MODE=true

# node scripts/prepare-env.mjs يولّد السر المحلي ولا يطبع قيمته.
BETTER_AUTH_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
APP_ENV=local
MAIL_MODE=local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Petra <hello@petra.test>
# Private local media and worker readiness (never serve this folder as static files).
PETRA_MEDIA_ROOT=/workspace/pet/.data/media
WORKER_HEALTH_PORT=4002

# Optional road provider. The public demo is a local-development default only.
# OSRM_ENDPOINT=https://router.project-osrm.org
# Optional private media provider; keep credentials out of source and the browser.
# MEDIA_STORAGE_BACKEND=s3
# MEDIA_S3_ENDPOINT=https://storage.example.invalid
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_BUCKET=petra-private
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_ENCRYPTION_KEY=
# MEDIA_ANTIVIRUS_SOCKET=/private/scan/clamd.sock
