# Copy OUTSIDE the checkout, owned by the operator, chmod 0600.
# Leave no real credentials in Git or chat. Blank values deliberately fail checks.
APP_ENV=production
PETRA_DEMO_MODE=false
APP_ORIGIN=
BETTER_AUTH_SECRET=
DATABASE_URL=
REDIS_URL=
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Alternative to SMTP, e.g. on Render Free: set MAIL_MODE=resend.
# Use only server secrets; MAIL_FROM must be a verified sender for public use.
RESEND_API_KEY=
MAIL_FROM=
MEDIA_STORAGE_BACKEND=s3
PETRA_S3_ENDPOINT=
PETRA_S3_REGION=
PETRA_S3_BUCKET=
PETRA_S3_ACCESS_KEY_ID=
PETRA_S3_SECRET_ACCESS_KEY=
PETRA_MEDIA_ENCRYPTION_KEY=
PETRA_MEDIA_ROOT=/tmp/petra-media
PETRA_CLAMAV_SOCKET=/run/petra-scanner/clamd.sock
OSRM_ENDPOINT=
SECURITY_REVIEW_REPORT=
SECURITY_REVIEW_PUBLIC_KEY_FILE=
RETENTION_POLICY_FILE=
# MIGRATION_DATABASE_URL belongs only in the separate maintenance environment.
