  "narrative": {
    "northStar": "Companion editorial journal",
    "overview": "Petra is calm, open and personal: clear Arabic typography, blue accents, white and pale blue fields, and photographs that give animals room in the composition. The owner approved this identity and delegated its application. This is a scan of the implemented web system, not a claim of fidelity to an approved image comp.\n\nPublic discovery uses generous space and large sentences; operating screens use compact headings, neutral navigation, tabular figures and flat panels. They share an identity without sharing density. Conceptual brand photographs are authored imagery, not evidence of actual patients, premises or endorsements.",
    "keyCharacteristics": [
      "Arabic first, RTL, with locally bundled fonts.",
      "One blue brand accent, supported by cool neutrals and semantic status colors.",
      "Photographic public storytelling and compact, task-led workspaces.",
      "Readable content before motion, with native touch scrolling and reduced motion support."
    ],
    "rules": [
      {
        "name": "The Contextual Accent Rule",
        "body": "Use blue for public emphasis and neutral ink for operating primary actions; do not turn the working rail into a saturated marketing surface.",
        "section": "colors"
      },
      {
        "name": "The Arabic Breathing Rule",
        "body": "Preserve the established line heights and wrapping when changing copy; do not compress Arabic to imitate Latin display density.",
        "section": "typography"
      },
      {
        "name": "The Flat Working Surface Rule",
        "body": "Give operating panels hierarchy with spacing, borders and headings; do not add ornamental elevation to routine tasks.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** share the blue/white identity while keeping public discovery generous and operating work compact.",
      "**Do** keep Arabic RTL, logical spacing, local fonts, visible focus and semantic controls.",
      "**Do** use real content and honest loading, empty, error and unavailable states in account workspaces.",
      "**Do** keep photographs conceptual when their provenance is conceptual; preserve their provenance records.",
      "**Do** preserve native touch and workspace scrolling and respect reduced motion and Save-Data."
    ],
    "donts": [
      "**Don't** invent metrics, testimonials, endorsements or verification claims to fill visual space.",
      "**Don't** replace task panels with ornamental gradients, floating badges or decorative charts.",
